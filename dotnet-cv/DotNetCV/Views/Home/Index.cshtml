@model DotNetCV.ViewModels.CvViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Edon Bytyqi - CV";
}

<section id="home" class="hero-section">
    <div class="hero-content">
        <div class="hero-image">
            <div class="profile-circle"></div>
        </div>
        <h1 class="hero-name">@Model.AboutMe.FirstName <span class="highlight">@Model.AboutMe.LastName</span></h1>
        <p class="hero-subtitle">@Model.AboutMe.Title</p>
        <div class="tech-badge-hero">
            <span class="badge-dot"></span>
            Built with C# .NET
        </div>
    </div>
    <div class="scroll-indicator">
        <span>↓</span>
    </div>
</section>

<section id="about" class="content-section">
    <div class="container-custom">
        <h2 class="section-title">ABOUT ME</h2>
        <div class="section-content">
            <p>@Model.AboutMe.Bio</p>
        </div>
    </div>
</section>

<section id="experience" class="content-section alt-bg">
    <div class="container-custom">
        <h2 class="section-title">EXPERIENCE</h2>
        <div class="timeline">
            @foreach (var exp in Model.Experiences)
            {
                <div class="timeline-item">
                    <div class="timeline-date">
                        @exp.StartDate.ToString("MMM yyyy", CultureInfo.InvariantCulture) - @(exp.IsCurrentJob ? "Present" : exp.EndDate?.ToString("MMM yyyy", CultureInfo.InvariantCulture))
                    </div>
                    <div class="timeline-content">
                        <h3>@exp.JobTitle</h3>
                        <h4>@exp.Company@(string.IsNullOrEmpty(exp.Location) ? "" : ", " + exp.Location)</h4>
                        @if (exp.Responsibilities.Any())
                        {
                            <ul>
                                @foreach (var responsibility in exp.Responsibilities)
                                {
                                    <li>@responsibility</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="education" class="content-section">
    <div class="container-custom">
        <h2 class="section-title">EDUCATION</h2>
        <div class="education-grid">
            @foreach (var edu in Model.Education)
            {
                <div class="education-card">
                    <div class="edu-year">
                        @edu.YearRange
                    </div>
                    <h3>@edu.Degree</h3>
                    <p>@edu.Institution@(string.IsNullOrEmpty(edu.Location) ? "" : ", " + edu.Location)</p>
                    @if (!string.IsNullOrEmpty(edu.Grade))
                    {
                        <p class="grade">@edu.Grade</p>
                    }
                    @if (!string.IsNullOrEmpty(edu.Description))
                    {
                        <p>@edu.Description</p>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section id="skills" class="content-section alt-bg">
    <div class="container-custom">
        <h2 class="section-title">TECHNICAL SKILLS</h2>
        <div class="skills-grid">
            @foreach (var category in Model.SkillCategories)
            {
                <div class="skill-category">
                    <h3>@category.CategoryName</h3>
                    <div class="skill-tags">
                        @foreach (var skill in category.Skills)
                        {
                            <span class="skill-tag">@skill</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section id="contact" class="content-section">
    <div class="container-custom">
        <h2 class="section-title">CONTACT</h2>
        <div class="contact-grid">
            <div class="contact-item">
                <div class="contact-icon">✉</div>
                <div class="contact-info">
                    <h4>Email</h4>
                    <p><a href="mailto:@Model.Contact.Email">@Model.Contact.Email</a></p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Contact.Phone))
            {
                <div class="contact-item">
                    <div class="contact-icon">📱</div>
                    <div class="contact-info">
                        <h4>Phone</h4>
                        <p>@Model.Contact.Phone</p>
                    </div>
                </div>
            }
            <div class="contact-item">
                <div class="contact-icon">📍</div>
                <div class="contact-info">
                    <h4>Location</h4>
                    <p>@Model.Contact.Location</p>
                </div>
            </div>
        </div>
    </div>
</section>