@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="section error-page" aria-labelledby="error-heading">
    <div class="section-inner">
        <span class="section-label">Error</span>
        <h1 id="error-heading" class="section-title">Something went wrong</h1>
        <p class="lead">Sorry, this page couldn't be loaded. Please try again in a moment.</p>

        @if (Model.ShowRequestId)
        {
            <p class="request-id">Request ID: <code>@Model.RequestId</code></p>
        }

        <p><a class="button" href="/">Back to the CV</a></p>
    </div>
</section>
