@using DotNetCV.ViewModels
@{
    // Only the CV page has a sidebar model, so the error page never depends on the CV service
    var sidebar = (Model as CvViewModel)?.Sidebar;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Edon Bytyqi</title>
    <meta name="description"
        content="Edon Bytyqi – software developer with 6+ years in enterprise IT: SAP, Avaloq, C#/.NET and production GenAI systems (RAG, agents, MCP)">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    @if (sidebar is not null)
    {
        <div class="sidebar">
            <div class="sidebar-header">
                <div class="logo"></div>
                <h3>@sidebar.Name</h3>
            </div>
            <nav class="sidebar-nav" aria-label="Main navigation">
                @foreach (var item in sidebar.NavigationItems)
                {
                    <a href="@item.Href" class="nav-item">@item.Label</a>
                }
            </nav>
            <div class="tech-switch">
                <div class="switch-label">TECH STACK</div>
                @foreach (var tech in sidebar.TechStackItems)
                {
                    <a href="@tech.Url" class="tech-btn @(tech.IsActive ? "active" : null)"
                        aria-label="@tech.Description"
                        aria-current="@(tech.IsActive ? "page" : null)"
                        target="@(tech.OpensInNewTab ? "_blank" : null)"
                        rel="@(tech.OpensInNewTab ? "noopener noreferrer" : null)">@tech.Label</a>
                }
            </div>
            <div class="sidebar-footer">
                <div class="social-links">
                    @foreach (var link in sidebar.SocialLinks)
                    {
                        <a href="@link.Url" class="social-icon" target="_blank" rel="noopener noreferrer"
                            aria-label="@link.Label (opens in a new tab)">@link.Icon</a>
                    }
                </div>
            </div>
        </div>
    }
    <div class="main-content">
        @RenderBody()
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
